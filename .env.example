# Copy this file to .env and fill in real values before running the app.

# -----------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------

# Runtime URL. Use Neon pooled endpoint (-pooler) for serverless hosting; local Docker overrides this with its Postgres service URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mangayomi_sync"

# Direct URL used by Prisma CLI for migrations. Keep it unpooled (no -pooler hostname).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/mangayomi_sync"

# Docker Compose database credentials. Use a URL-safe password, for example
# the output of `openssl rand -hex 32`. Compose builds the container DATABASE_URL
# from these values and the `postgres` service name.
POSTGRES_USER="mangayomi"
POSTGRES_PASSWORD="replace-with-a-random-hex-password"
POSTGRES_DB="mangayomi_sync"

# -----------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------

# Signs session JWTs; generate with `openssl rand -base64 48`, never reuse across environments.
SESSION_SECRET="change-me"

# -----------------------------------------------------------------------
# File storage
# -----------------------------------------------------------------------

# Where uploaded profile pictures are stored on disk, default ./storage/avatars.
# AVATAR_STORAGE_DIR="./storage/avatars"

# -----------------------------------------------------------------------
# Networking
# -----------------------------------------------------------------------

# Trust CF-Connecting-IP / X-Forwarded-For / X-Real-IP for the client's real IP. Defaults to NOT trusting them (every request looks
# like "unknown"), which is safe but makes rate limiting and ban-evasion checks less effective. Set to "true" only when this server
# sits behind a reverse proxy or tunnel (Cloudflare Tunnel, nginx, Caddy) that overwrites these headers itself, never sets them from
# a direct/unproxied client, or they're trivially spoofable by anyone.
# TRUST_PROXY_HEADERS="true"

# Port the app listens on; Next.js reads this automatically, only needed if 3000 is taken.
# PORT="3000"

# Comma-separated hosts allowed to reach dev-only Next.js resources (hot reload) when not using localhost.
# TRUSTED_DOMAIN="example.com"
